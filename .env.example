# ConvertKit / Kit Integration Configuration
# Copy this file to .env or .env.local and fill in the values below.

# Your Public API Key (starts with pk_ or a public string key. Do NOT use API Secret!)
# Obtain this from Kit settings > Advanced
VITE_CONVERTKIT_API_KEY=your_public_api_key_here

# The numeric ID of the form you created in Kit (e.g., 1234567)
# Obtain this from the embed HTML code of your Form in Kit
VITE_CONVERTKIT_FORM_ID=your_form_id_here
